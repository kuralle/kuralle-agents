{
  "name": "@kuralle-agents/cf-agent",
  "version": "0.22.0",
  "description": "Kuralle agent integration for Cloudflare Workers with AIChatAgent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test src/__tests__ && vitest run --config vitest.config.ts",
    "test:sql-memory-workers": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kuralle-agents/core": "workspace:*",
    "@kuralle-agents/deployment": "workspace:*",
    "@kuralle-agents/fs": "workspace:*",
    "@kuralle-agents/messaging": "workspace:*",
    "@cloudflare/ai-chat": "^0.10.1",
    "ai": "^6.0.90"
  },
  "peerDependencies": {
    "agents": ">=0.20.1 <1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "agents": "^0.20.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "kuralle",
    "ai",
    "agents",
    "cloudflare",
    "durable-objects",
    "chat",
    "conversational-ai"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/kuralle-agents.git",
    "directory": "packages/cf-agent"
  }
}
