{
  "name": "@kuralle-agents/deployment",
  "version": "0.19.0",
  "description": "Canonical agent revisions, releases, and thread pins for Kuralle deployments",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/kuralle-agents.git",
    "directory": "packages/deployment"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test ./test/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kuralle-agents/core": "workspace:*",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/node": "^20.11.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
