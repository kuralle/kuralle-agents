{
  "name": "@kuralle-agents/tui",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/kuralle-agents.git",
    "directory": "packages/tui"
  },
  "version": "0.24.0",
  "description": "OpenTUI chat surface for Kuralle sessions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kuralle-tui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test ./test/",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "dependencies": {
    "@kuralle-agents/client": "workspace:*",
    "@kuralle-agents/core": "workspace:*",
    "@opentui/core": "0.5.6",
    "@opentui/react": "0.5.6",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
