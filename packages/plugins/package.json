{
  "name": "@kuralle-agents/plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/kuralle-agents.git",
    "directory": "packages/plugins"
  },
  "version": "0.21.1",
  "description": "Agent Plugins loader and conformance for Kuralle agents",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@kuralle-agents/core": "workspace:*",
    "@kuralle-agents/fs": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/openai": "^3.0.89",
    "@ai-sdk/xai": "^3.0.73",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@kuralle-agents/fs": "workspace:*",
    "@kuralle-agents/mcp": "workspace:*",
    "@types/node": "^22.5.0",
    "ai": "6.0.237",
    "bun-types": "^1.3.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test ./test/ && vitest run --config vitest.config.ts",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
