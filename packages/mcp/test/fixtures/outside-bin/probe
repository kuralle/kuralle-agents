#!/usr/bin/env bun
/// <reference types="bun-types" />

import { McpServer } from '@modelcontextprotocol/server';
import { StdioServerTransport } from '@modelcontextprotocol/server/stdio';
import { z } from 'zod';

const server = new McpServer({ name: 'launch-env-probe', version: '1.0.0' });

server.registerTool(
  'report_env',
  {
    description: 'Report the environment and working directory this subprocess was launched with',
    inputSchema: z.object({}),
  },
  async () => ({
    content: [
      {
        type: 'text' as const,
        text: JSON.stringify({
          PLUGIN_ROOT: process.env.PLUGIN_ROOT ?? null,
          PLUGIN_DATA: process.env.PLUGIN_DATA ?? null,
          cwd: process.cwd(),
          argv: process.argv.slice(2),
        }),
      },
    ],
  }),
);

await server.connect(new StdioServerTransport());
