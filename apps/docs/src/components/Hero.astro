---
const path = Astro.url.pathname;
const base = path !== '/' ? (!path.endsWith('/') ? path + '/' : path) : '/';
const quickstartLink = base + 'guides/quickstart';
const examplesLink = base + 'examples/';
---

<div class="aria-hero">
  <h2 class="aria-hero-title"><slot name="title" /></h2>
  <p class="aria-hero-desc"><slot name="description" /></p>
  <div class="aria-hero-actions">
    <a href={quickstartLink} class="aria-hero-cta">
      <slot name="cta" />
    </a>
    <a href={examplesLink} class="aria-hero-secondary">Explore examples <span aria-hidden="true">↗</span></a>
  </div>
</div>
