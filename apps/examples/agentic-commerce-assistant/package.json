{
  "name": "@kuralle-examples/agentic-commerce-assistant",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "cf:types": "wrangler types --config wrangler.jsonc",
    "cf:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc",
    "node": "bun node/server.ts",
    "node:neon": "bun --env-file=.env.neon node/server.ts",
    "bootstrap": "bun scripts/bootstrap.ts",
    "bootstrap:neon": "bun --env-file=.env.neon scripts/bootstrap.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.89",
    "@cloudflare/ai-chat": "^0.10.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@hono/node-server": "^2.0.12",
    "@kuralle-agents/cf-agent": "workspace:*",
    "@kuralle-agents/commerce": "workspace:*",
    "@kuralle-agents/core": "workspace:*",
    "@kuralle-agents/pi-driver": "workspace:*",
    "@kuralle-agents/postgres-store": "workspace:*",
    "@samesake/core": "6.0.2",
    "@samesake/embed": "6.0.1",
    "@samesake/enrich": "6.0.2",
    "@samesake/query": "6.0.1",
    "@samesake/server": "6.0.2",
    "agents": "^0.20.1",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.19",
    "ai": "6.0.237",
    "pg": "8.22.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
