# Shared model settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vercel/Node durability. Any TLS PostgreSQL URL is supported.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kuralle_support

# Generate with: openssl rand -hex 32
SUPPORT_IDENTITY_SECRET=

# Fast local evaluation only. Production intentionally refuses this mode.
SUPPORT_DEMO_MODE=true

# Production support-system adapter (used when SUPPORT_DEMO_MODE is not true).
SUPPORT_API_URL=https://support-api.example.com
SUPPORT_API_TOKEN=

# Cloudflare only: comma-separated browser origins allowed to send credentials.
ALLOWED_ORIGINS=http://localhost:3000
